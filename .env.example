PORT=3000
# Set in production. Never commit an actual connection string.
# DATABASE_URL=postgresql://...
# DATABASE_SSL=true
# PUBLIC_ORIGIN=https://lara.example.com
# On Render, set TRUST_PROXY=1 (one trusted edge proxy).
TRUST_PROXY=0
# SQLite is durable locally; ephemeral cloud disks REQUIRE Postgres.
DATA_DIR=./data
MAX_ACCOUNTS=20
