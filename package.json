{
  "name": "lara-operator",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.13.0" },
  "scripts": {
    "build": "node scripts/build.js",
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "test": "node --test --test-concurrency=1 tests/*.test.js",
    "check": "node --check src/server.js && node --check src/worker.js && node --check public/app.js"
  },
  "dependencies": {
    "exceljs": "4.4.0",
    "express": "5.1.0",
    "helmet": "8.1.0",
    "pg": "8.16.3"
  },
  "devDependencies": { "@playwright/test": "1.56.1", "esbuild": "0.25.12", "@mlc-ai/web-llm": "0.2.88" },
  "overrides": { "exceljs": { "uuid": "11.1.1" } },
  "pnpm": { "overrides": { "exceljs>uuid": "11.1.1" } }
}
